---
// Plaquinha "Desenvolvido por" da Neon Scripts: modelo único de todo site de cliente (o do Naruá).
// Pedido do Brenno em 2026-10-28: passa por cima da regra de cores só aqui.
---

<p class="neon-assinatura">Desenvolvido por <a class="neon-link" href="https://neonscripts.com.br/" target="_blank" rel="noopener" aria-label="Neon Scripts (abre em nova aba)"><span class="nn">N<span class="ne">E</span><span class="no"><svg viewBox="0 0 100 100" aria-hidden="true"><g class="palpebra"><path class="tubo" d="M4 50 Q50 -2 96 50 Q50 102 4 50 Z"/><circle class="iris" cx="50" cy="50" r="15"/><circle class="pupila" cx="50" cy="50" r="6.5"/></g></svg></span>N</span><span class="ns">SCRIPTS</span></a></p>

<style is:global>
  /* Assinatura Neon Scripts: plaquinha neon no rodapé, mesmas cores do neonscripts.com.br */
  .neon-link{--glow:#FF2E9A;--glow2:#A24BFF;--tube:#FFB8DC;--glowB:#2E8CFF;--tubeB:#B0DCFF;display:inline-flex;flex-direction:column;align-items:center;vertical-align:middle;margin:4px 0 0 6px;padding:5px 11px 6px;border:2px solid var(--tube);border-radius:9px;background:rgba(7,3,26,.65);box-shadow:0 0 6px var(--glow),0 0 18px var(--glow2),inset 0 0 6px var(--glow);font-family:'Bungee Inline','Titan One',sans-serif;line-height:1;text-decoration:none;transition:box-shadow .4s,border-color .4s,transform .25s;animation:neonZumbido 9s linear 2s infinite;}
  .neon-link .nn{font-size:16px;letter-spacing:.03em;color:var(--tube);text-shadow:0 0 4px var(--glow),0 0 12px var(--glow),0 0 26px var(--glow);}
  .neon-link .ns{font-size:7.5px;letter-spacing:.14em;margin-top:2px;color:var(--tubeB);text-shadow:0 0 3px var(--glowB),0 0 9px var(--glowB);}
  /* Logo v3 (2026-10-28): E ao contrário e o O vira olho amendoado, íris na cor de SCRIPTS. Fonte: marca/VERSOES.md no repo Neon */
  .neon-link .nn{display:inline-flex;align-items:center}
  .neon-link .ne{display:inline-block;transform:scaleX(-1)}
  .neon-link .no{display:inline-flex;align-items:center;width:.86em;height:1em;margin:0 .02em}
  .neon-link .no svg{display:block;width:100%;height:.86em;overflow:visible;filter:drop-shadow(0 0 2px var(--glow)) drop-shadow(0 0 6px var(--glow))}
  .neon-link .tubo{fill:none;stroke:var(--tube);stroke-width:13;stroke-linejoin:round}
  .neon-link .iris{fill:none;stroke:var(--tubeB);stroke-width:5.5}
  .neon-link .pupila{fill:var(--tubeB)}
  .neon-link .palpebra{transform-box:fill-box;transform-origin:center;transition:transform 140ms cubic-bezier(.22,1,.36,1)}
  .neon-link.fecha .palpebra{transform:scaleY(.06);transition-duration:110ms}
  .neon-link.acende{animation:neonAcende 1.1s linear both,neonZumbido 9s linear 3s infinite;}
  .neon-link:hover,.neon-link:focus-visible{--glow:#2E8CFF;--glow2:#40E6DC;--tube:#B0DCFF;--glowB:#FF2E9A;--tubeB:#FFB8DC;transform:translateY(-2px) scale(1.04);outline:none;}
  @keyframes neonAcende{0%{opacity:.08}10%{opacity:1}14%{opacity:.2}22%{opacity:1}27%{opacity:.35}36%,100%{opacity:1}}
  @keyframes neonZumbido{0%,93%,100%{opacity:1}94%{opacity:.35}95%{opacity:1}96.5%{opacity:.5}97.5%{opacity:1}}
  @media (prefers-reduced-motion:reduce){.neon-link,.neon-link.acende{animation:none;}.neon-link .palpebra{transition:none;}}
  .neon-assinatura{margin:14px 0 0;font-size:12px;text-align:center}
</style>

<script>
/* Plaquinha Neon Scripts: pisca ao acender quando aparece na tela */
(function(){var p=document.querySelector('.neon-link');if(!p||!('IntersectionObserver' in window))return;
var o=new IntersectionObserver(function(e){if(e[0].isIntersecting){p.classList.remove('acende');void p.offsetWidth;p.classList.add('acende');}},{threshold:.6});o.observe(p);
/* O olho pisca de vez em quando, só com a placa na tela */
var visivel=false,calmo=window.matchMedia('(prefers-reduced-motion: reduce)').matches;
new IntersectionObserver(function(e){visivel=e[0].isIntersecting;}).observe(p);
if(!calmo)setInterval(function(){if(!visivel||Math.random()>.45)return;p.classList.add('fecha');setTimeout(function(){p.classList.remove('fecha');},150);},2600);
})();
</script>
