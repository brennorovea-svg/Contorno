---
/*
  Primeira tela da Home: a maquete do apartamento, desenhada com o kit
  da skill Anatomy (figures/maquete/build.mjs gera o SVG).
  Em loop de 18 s, as três fases do site viram três momentos da maquete:
    Conceitual  a planta se desenha na base
    Executivo   os móveis entram no desenho e o carimbo aprova o orçamento
    Gestão      só então as paredes e os móveis sobem
  As fases são capítulos clicáveis, há botão de pausa, o movimento para
  fora da tela, e quem prefere menos movimento vê a maquete pronta.
*/
import maquete from './maquete/maquete.svg?raw';
import './maquete/tema.css';

interface Props {
  whatsapp: string;
}
const { whatsapp } = Astro.props;
---
<section class="hero" aria-label="Primeira tela">
  <figure class="palco maquete" aria-label="Maquete do apartamento">
    <Fragment set:html={maquete} />
    <figcaption class="leitura" id="leitura">Conceitual · a planta no papel</figcaption>
  </figure>

  <div class="wrap texto">
    <p class="rotulo">+80 obras entregues em São Paulo</p>
    <h1>Planeje antes de quebrar.</h1>
    <p class="apoio">A obra só começa com todos os orçamentos aprovados. Quem desenha o projeto acompanha a execução, para entregar no prazo e no custo previstos.</p>
    <div class="acoes">
      <a class="btn" href={whatsapp}>Quero planejar minha obra</a>
      <a class="link" href="#como-trabalhamos">Como funciona</a>
      <a class="link" href="#obras">Obras entregues</a>
    </div>
  </div>

  <div class="wrap controle">
    <div class="capitulos" role="group" aria-label="Fases do filme">
      <button class="cap" type="button" data-cap="0" style="--c: var(--color-terra-claro)"><span>Conceitual</span><i><b></b></i></button>
      <button class="cap" type="button" data-cap="1" style="--c: var(--color-terra-medio)"><span>Executivo</span><i><b></b></i></button>
      <button class="cap" type="button" data-cap="2" style="--c: var(--color-terra)"><span>Gestão</span><i><b></b></i></button>
    </div>
    <button class="pausa" id="pausa" type="button" aria-pressed="false">Pausar</button>
  </div>
</section>

<script>
(() => {
  const svg = document.querySelector('.palco svg') as SVGSVGElement | null;
  if (!svg) return;
  const D = JSON.parse(svg.dataset.maquete || '{}');
  const T = 18;                          // duração do loop, em segundos
  const FASES = [0, 6, 12];              // início de cada capítulo
  const LEITURAS = ['Conceitual · a planta no papel', 'Executivo · orçamentos aprovados', 'Gestão · a obra começa'];
  const reduz = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let t = reduz ? 16.8 : 0, rodando = !reduz, ultimo = 0, visivel = true, quadroId = 0;

  const clamp = (v: number, a = 0, b = 1) => Math.max(a, Math.min(b, v));
  const suave = (v: number) => v * v * (3 - 2 * v);
  const sai = (v: number) => 1 - Math.pow(1 - v, 3);
  const janela = (t: number, a: number, d: number) => clamp((t - a) / d);
  const lista = (step: string) => [...svg.querySelectorAll<SVGGElement>(`[data-step="${step}"]`)]
    .sort((a, b) => Number(a.dataset.i) - Number(b.dataset.i));
  const planta = lista('plan'), riscos = lista('risco'), paredes = lista('parede'), moveis = lista('movel'), aprovados = lista('aprovado');
  const carimbo = svg.querySelector<SVGGElement>('[data-part="carimbo"]')!;
  const sombra = svg.querySelector<SVGGElement>('[data-part="sombra"]')!;
  const camadas = [...svg.querySelectorAll<SVGGElement>('[data-layer]')];
  const leitura = document.getElementById('leitura')!;
  for (const g of [...planta, ...riscos]) g.querySelectorAll('path').forEach((p) => p.style.strokeDasharray = '1 1');

  // posição na planta -> deslocamento na tela, com os eixos da câmera da figura
  const tela = ([x, y, z]: number[]) => [x * D.ax[0] + y * D.ay[0] + z * D.az[0], x * D.ax[1] + y * D.ay[1] + z * D.az[1]];
  const mover = (g: SVGGElement, p: number[]) => { const [dx, dy] = tela(p); g.setAttribute('transform', `translate(${dx.toFixed(2)} ${dy.toFixed(2)})`); };
  const mistura = (a: number[], b: number[], k: number) => a.map((v, i) => v + (b[i] - v) * k);

  // roteiro do carimbo: molha na almofada e aprova as três linhas
  const ALTO = 16;
  const acima = (p: number[]) => [p[0], p[1], p[2] + ALTO];
  const paradas: [number, number[]][] = [[7.0, acima(D.rest)], [7.35, D.pad], [7.7, acima(D.pad)]];
  let tt = 7.7;
  D.rows.forEach((r: number[]) => { paradas.push([tt + 0.55, acima(r)], [tt + 0.75, r], [tt + 1.05, acima(r)]); tt += 1.05; });
  paradas.push([tt + 0.7, acima(D.rest)], [tt + 1.0, D.rest]);
  const prensas = D.rows.map((_: number[], i: number) => 7.7 + i * 1.05 + 0.75);
  function posCarimbo(t: number) {
    let antes: [number, number[]] = [0, D.rest];
    for (const p of paradas) { if (t < p[0]) return mistura(antes[1], p[1], suave(clamp((t - antes[0]) / (p[0] - antes[0])))); antes = p; }
    return D.rest;
  }

  function quadro(t: number) {
    const some = 1 - suave(janela(t, 17.2, 0.8));
    camadas.forEach((g) => g.style.opacity = String(some));
    planta.forEach((g, i) => { const k = sai(janela(t, 0.4 + i * 0.22, 0.9)); g.style.setProperty('--traco', String(1 - k)); g.style.opacity = k > 0 ? '1' : '0'; });
    riscos.forEach((g, i) => { const k = sai(janela(t, 6.1 + i * 0.1, 0.7)); g.style.setProperty('--traco', String(1 - k)); g.style.opacity = k > 0 ? '1' : '0'; });
    aprovados.forEach((g, i) => { g.style.opacity = String(suave(janela(t, prensas[i] - 0.05, 0.25))); });
    const sobe = (g: SVGGElement, a: number) => { const k = janela(t, a, 0.7); g.style.opacity = String(suave(clamp(k * 2.2))); mover(g, [0, 0, 26 * (1 - sai(k))]); };
    paredes.forEach((g, i) => sobe(g, 12.2 + i * 0.1));
    moveis.forEach((g, i) => sobe(g, 14.3 + i * 0.08));
    const c = posCarimbo(t);
    mover(carimbo, c); mover(sombra, [c[0], c[1], D.rest[2]]);
    sombra.style.opacity = String(1 - clamp((c[2] - D.rest[2]) / (ALTO * 1.6)));
    const fase = t >= FASES[2] ? 2 : t >= FASES[1] ? 1 : 0;
    if (leitura.textContent !== LEITURAS[fase]) leitura.textContent = LEITURAS[fase];
  }

  // ---------- capítulos e pausa ----------
  const caps = [...document.querySelectorAll<HTMLButtonElement>('.cap')];
  function marcar(t: number) {
    caps.forEach((b, i) => {
      const a = FASES[i], z = FASES[i + 1] ?? T;
      b.querySelector('b')!.style.width = (clamp((t - a) / (z - a)) * 100) + '%';
      b.setAttribute('aria-current', t >= a && t < z ? 'step' : 'false');
    });
  }
  const pintar = () => { quadro(t); marcar(t); };
  caps.forEach((b, i) => b.addEventListener('click', () => { t = FASES[i] + 0.01; if (!rodando) pintar(); }));
  const pausa = document.getElementById('pausa')!;
  function rotulo() { pausa.textContent = rodando ? 'Pausar' : 'Tocar'; pausa.setAttribute('aria-pressed', String(!rodando)); }
  pausa.addEventListener('click', () => { rodando = !rodando; rotulo(); seguir(); });
  rotulo();

  function loop(ms: number) {
    quadroId = 0;
    if (!rodando || !visivel) return;
    if (ultimo) t = (t + Math.min(.05, (ms - ultimo) / 1000)) % T;
    ultimo = ms;
    pintar();
    quadroId = requestAnimationFrame(loop);
  }
  function seguir() { ultimo = 0; if (rodando && visivel && !quadroId) quadroId = requestAnimationFrame(loop); }
  // fora da tela, o filme para (economiza bateria)
  new IntersectionObserver((e) => { visivel = e[e.length - 1].isIntersecting; seguir(); }).observe(svg);
  pintar();
  seguir();
})();
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--color-verde);
    min-height: min(calc(100svh - 5rem), 760px);
    display: flex;
    flex-direction: column;
  }
  /* A maquete: à direita no computador, em cima do texto no celular */
  .palco {
    margin: 0;
    pointer-events: none;
  }
  .palco :global([data-step="plan"] path),
  .palco :global([data-step="risco"] path) { stroke-dashoffset: var(--traco, 0); }
  .leitura {
    margin: 4px 4% 0;
    text-align: right;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: .2em;
    text-transform: uppercase;
    color: var(--color-floresta-profundo);
  }
  @media (min-width: 900px) {
    .palco {
      position: absolute;
      z-index: -1;
      top: 50%;
      /* começa logo depois do título e nunca passa da borda da tela */
      --inicio: calc(max(32px, (100vw - 1200px) / 2) + min(43vw, 560px));
      left: var(--inicio);
      width: min(720px, calc(100vw - var(--inicio) - 16px));
      transform: translateY(-50%);
    }
  }
  @media (max-width: 899px) {
    .palco { order: -1; width: min(100%, 640px); margin: 8px auto 4px; padding-inline: 4px; }
    .leitura { font-size: 11px; letter-spacing: .14em; }
  }
  .wrap {
    width: 100%;
    max-width: 1200px;
    margin-inline: auto;
    padding-left: max(16px, env(safe-area-inset-left, 0px));
    padding-right: max(16px, env(safe-area-inset-right, 0px));
  }
  @media (min-width: 768px) {
    .wrap { padding-left: max(32px, env(safe-area-inset-left, 0px)); padding-right: max(32px, env(safe-area-inset-right, 0px)); }
  }

  /* Texto da primeira tela */
  .texto {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 24px;
    padding-block: 40px 32px;
  }
  .rotulo {
    font-weight: 700;
    font-size: 12px;
    letter-spacing: .2em;
    text-transform: uppercase;
  }
  h1 {
    margin: 0;
    font-family: var(--font-titulo);
    font-weight: 900;
    text-transform: uppercase;
    line-height: 1.0;
    letter-spacing: .01em;
    color: var(--color-branco);
    font-size: clamp(2.5rem, 7.4vw, 6rem);
    max-width: 10ch;
    text-wrap: balance;
  }
  .apoio { margin: 0; max-width: 38ch; font-size: clamp(1rem, 1.6vw, 1.2rem); }
  .acoes { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 28px; margin-top: 8px; }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 15px 28px;
    border-radius: 6px;
    background: var(--color-terra-destaque);
    color: var(--color-gelo);
    font-weight: 700;
    font-size: 18px;
    text-decoration: none;
    transition: transform .2s, background-color .2s;
  }
  .btn:hover { transform: translateY(-2px); }
  .link {
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: var(--color-branco);
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }

  /* As 3 fases como capítulos do filme */
  .capitulos {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    padding-block: 0 24px;
    align-items: end;
  }
  .cap {
    appearance: none;
    border: 0;
    background: none;
    padding: 0;
    text-align: left;
    font: inherit;
    color: var(--color-floresta-profundo);
    cursor: pointer;
    display: grid;
    gap: 8px;
  }
  .cap span {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .16em;
    text-transform: uppercase;
  }
  .cap i {
    display: block;
    height: 4px;
    border-radius: 2px;
    background: rgba(255,255,255,.45);
    overflow: hidden;
  }
  .cap i b { display: block; height: 100%; width: 0; background: var(--c); border-radius: 2px; }
  .pausa {
    justify-self: end;
    appearance: none;
    border: 2px solid var(--color-floresta-profundo);
    background: none;
    color: var(--color-floresta-profundo);
    border-radius: 6px;
    font: inherit;
    font-size: 13px;
    font-weight: 700;
    padding: 6px 12px;
    cursor: pointer;
  }
  .controle { display: grid; grid-template-columns: 1fr auto; gap: 20px; align-items: end; }
  @media (max-width: 767px) {
    .texto { justify-content: flex-start; padding-block: 12px 28px; }
    .cap span { font-size: 11px; letter-spacing: .08em; }
    .controle { grid-template-columns: 1fr; gap: 16px; }
    .pausa { justify-self: start; }
    .capitulos { padding-right: 64px; } /* espaço para o botão flutuante do WhatsApp */
  }
  @media (min-width: 768px) {
    .capitulos { max-width: 560px; gap: 20px; }
    .controle { padding-block-end: 8px; }
  }

</style>
