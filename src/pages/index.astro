---
import Base from '../layouts/Base.astro';
import Room from '../components/Room.astro';
import HeroFilme from '../components/HeroFilme.astro';
import { url } from '../lib/url';

const whatsapp =
  'https://wa.me/5511981660262?text=' +
  encodeURIComponent('Oi, Malu! Vou reformar e quero planejar minha obra.');

const fases = [
  {
    nome: 'Conceitual',
    cor: 'var(--color-terra-claro)',
    itens: ['Briefing', 'Conceito', 'Projeto preliminar'],
    texto: 'Entendemos como você vive e o que a obra precisa resolver. Você vê o espaço antes de gastar com ele.',
  },
  {
    nome: 'Executivo',
    cor: 'var(--color-terra-medio)',
    itens: ['Projeto executivo', 'Memorial descritivo', 'Fluxo financeiro'],
    texto: 'Cada detalhe desenhado e cada custo previsto. A obra só começa com todos os orçamentos aprovados.',
  },
  {
    nome: 'Gestão',
    cor: 'var(--color-terra)',
    itens: ['Gerenciamento da obra', 'Compras', 'Produção'],
    texto: 'Acompanhamos a execução de perto. Você acompanha tudo, como se estivesse na obra.',
  },
];

const pacotes = [
  { nome: 'Pacote 1', fases: 1, para: 'Para quem quer o projeto e toca a obra por conta própria.' },
  { nome: 'Pacote 2', fases: 2, para: 'Projeto completo, com cada custo previsto antes de começar.' },
  { nome: 'Pacote 3', fases: 3, para: 'Do conceito à entrega, com a obra acompanhada de perto.' },
];

// Mesma posição das aberturas em todos os ambientes da sequência, para o percurso atravessar
const passagem: [number, number] = [0.7, 0.9];
---

<Base title="Home">
  <!-- PRIMEIRA TELA: o filme da planta -->
  <HeroFilme whatsapp={whatsapp} />

  <!-- AFIRMAÇÃO -->
  <section class="bg-verde">
    <div class="mx-auto grid max-w-6xl gap-8 px-4 py-14 md:grid-cols-[1.4fr_1fr] md:items-end md:px-8 md:py-16">
      <p class="ec-display text-[clamp(2rem,4.6vw,3.5rem)] text-branco">
        Projeto e obra andam juntos.
      </p>
      <p class="max-w-[42ch] text-lg">
        A maioria das reformas estoura prazo e orçamento porque começa sem planejamento. Aqui é ao contrário: quem
        desenhou cada detalhe é quem está na obra, todos os dias que ela precisa.
      </p>
    </div>
  </section>

  <!-- AS 3 FASES: três ambientes ligados por portas -->
  <section id="como-trabalhamos" class="mx-auto max-w-6xl scroll-mt-24 px-4 py-16 md:px-8 md:py-20">
    <h2 class="ec-display ec-filete text-[clamp(1.75rem,3.6vw,2.5rem)]">Três ambientes, uma obra sem surpresa</h2>
    <p class="mt-6 max-w-[56ch] text-lg">
      Cada fase só termina quando você aprova. Você pode contratar só a primeira, as duas primeiras ou o caminho
      inteiro.
    </p>

    <div class="sequencia relative mt-10" data-sequencia>
      <ol class="grid gap-6 md:grid-cols-3 md:gap-0">
        {fases.map((f, i) => (
          <li class="md:-ml-[14px] md:first:ml-0">
            <Room
              left={i > 0 ? passagem : undefined}
              right={i < fases.length - 1 ? passagem : undefined}
              stroke={14}
              radius={28}
              color={f.cor}
              class="h-full"
            >
              <div class="flex h-full flex-col px-8 pb-24 pt-10">
                <p class="cota-texto">{i + 1}ª fase</p>
                <h3 class="mt-2 text-[1.75rem] font-bold leading-tight">{f.nome}</h3>
                <p class="mt-4">{f.texto}</p>
                <ul class="mt-6 space-y-1 text-[15px]">
                  {f.itens.map((item) => (
                    <li class="flex items-center gap-3">
                      <span class="h-[3px] w-4 rounded-full" style={`background:${f.cor}`}></span>
                      {item}
                    </li>
                  ))}
                </ul>
              </div>
            </Room>
          </li>
        ))}
      </ol>
      <svg class="percurso" data-percurso preserveAspectRatio="none" viewBox="0 0 100 10" aria-hidden="true">
        <line x1="2" y1="5" x2="98" y2="5" vector-effect="non-scaling-stroke" />
      </svg>
    </div>
  </section>

  <!-- PACOTES -->
  <section class="bg-branco">
    <div class="mx-auto max-w-6xl px-4 py-16 md:px-8 md:py-20">
      <h2 class="ec-display ec-filete text-[clamp(1.75rem,3.6vw,2.5rem)]">Até onde a gente vai junto</h2>

      <table class="pacotes mt-8 w-full">
        <caption class="sr-only">Fases incluídas em cada pacote</caption>
        <thead>
          <tr>
            <th scope="col" class="sr-only">Pacote</th>
            {fases.map((f) => <th scope="col">{f.nome}</th>)}
          </tr>
        </thead>
        <tbody>
          {pacotes.map((p) => (
            <tr>
              <th scope="row">
                <span class="block text-xl font-bold">{p.nome}</span>
                <span class="block text-[15px] font-normal">{p.para}</span>
              </th>
              {fases.map((f, i) => (
                <td>
                  {i < p.fases ? (
                    <span class="faixa" style={`background:${f.cor}`}><span class="sr-only">incluída</span></span>
                  ) : (
                    <span class="faixa faixa--vazia"><span class="sr-only">não incluída</span></span>
                  )}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- OBRAS -->
  <section class="mx-auto max-w-6xl px-4 py-16 md:px-8 md:py-20">
    <div class="grid gap-10 md:grid-cols-[1fr_1.3fr] md:items-center">
      <div>
        <h2 class="ec-display ec-filete text-[clamp(1.75rem,3.6vw,2.5rem)]">Obras entregues</h2>
        <p class="mt-6 max-w-[40ch] text-lg">
          Mais de 80 obras em São Paulo, cada uma no prazo e no custo combinados. A galeria completa chega aqui em breve.
        </p>
        <a
          href="https://www.instagram.com/estudiocontorno/"
          class="mt-8 inline-block font-semibold underline decoration-terra decoration-2 underline-offset-[6px] hover:text-floresta"
        >Ver obras no Instagram</a>
      </div>
      <!-- Provisório: substituir pelas fotos reais das obras -->
      <div class="flex aspect-[16/9] items-center justify-center rounded-lg bg-verde-claro text-floresta">
        Fotos das obras em breve
      </div>
    </div>
  </section>

  <!-- FECHAMENTO -->
  <section class="mx-auto max-w-6xl px-4 pb-16 md:px-8 md:pb-20">
    <Room left={[0.3, 0.7]} stroke={14} radius={28}>
      <div class="flex flex-col items-start gap-8 px-8 py-14 md:flex-row md:items-center md:justify-between md:px-16">
        <p class="ec-display text-[clamp(1.75rem,3.6vw,2.5rem)]">Sua obra começa<br />no planejamento.</p>
        <a href={whatsapp} class="ec-btn ec-btn-primario">Fale com a Malu</a>
      </div>
    </Room>
  </section>
</Base>

<style>
  /* Percurso: linha tracejada que atravessa as portas das 3 fases */
  .percurso {
    display: none;
  }
  @media (min-width: 768px) {
    .percurso {
      display: block;
      position: absolute;
      left: 0;
      right: 0;
      top: 80%;
      width: 100%;
      height: 20px;
      transform: translateY(-50%);
      overflow: visible;
      stroke: var(--color-floresta);
      stroke-width: 2;
      stroke-dasharray: 2 10;
      stroke-linecap: round;
      pointer-events: none;
    }
  }

  .cota-texto {
    font-size: .75rem;
    font-weight: 600;
    letter-spacing: .2em;
    text-transform: uppercase;
    color: var(--color-floresta);
  }

  /* Pacotes */
  .pacotes {
    border-collapse: separate;
    border-spacing: 0 12px;
  }
  .pacotes thead th {
    font-size: .75rem;
    font-weight: 600;
    letter-spacing: .2em;
    text-transform: uppercase;
    color: var(--color-floresta);
    text-align: left;
    padding: 0 6px 4px;
  }
  .pacotes tbody th {
    text-align: left;
    padding: 12px 24px 12px 0;
    width: 40%;
    vertical-align: middle;
  }
  .pacotes td {
    padding: 0 3px;
    vertical-align: middle;
  }
  .faixa {
    display: block;
    height: 44px;
    border-radius: 10px;
  }
  .faixa--vazia {
    border: 2px dashed var(--color-borda);
  }

  @media (max-width: 767px) {
    .pacotes, .pacotes tbody, .pacotes tr { display: block; }
    .pacotes thead { display: none; }
    .pacotes tr { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; margin-bottom: 24px; }
    .pacotes tbody th { grid-column: 1 / -1; width: auto; padding: 0 0 4px; }
    .pacotes td { padding: 0; }
    .faixa { height: 28px; }
  }
</style>
